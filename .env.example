# Copy to .env.local to override the tracked .env.development / .env.production.
#
# Vite inlines every VITE_* value into the JS bundle at build time, so nothing
# here is secret and nothing here can be changed after the build - a wrong
# value means rebuilding, not restarting.

# Where the SPA sends API calls.
#   dev   /api/v1  -> the vite proxy in vite.config.ts forwards to :5000
#   prod  /api/v1  -> nginx proxies /api/ to the backend on the same hostname
# Keep it relative. An absolute cross-origin URL makes the refresh-token
# cookie third-party, which Safari blocks.
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME=Everfresh Admin
VITE_APP_VERSION=1.0.0
